# Local development configuration only. Replace these values in .env before
# starting services; never use development credentials in shared environments.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ARTIFACT_MAX_SIZE_BYTES=5242880
ARTIFACT_BUCKET_NAME=engineering-artifacts

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=engineering_graph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

NEO4J_HOST=127.0.0.1
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-development-password
NEO4J_PORT=7687

MINIO_HOST=127.0.0.1
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-a-local-development-password
MINIO_PORT=9000
